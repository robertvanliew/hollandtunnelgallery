---
// Shop listing. Orders are requests: the gallery emails back to arrange payment and delivery.
import Base from '../../layouts/Base.astro';
import '../../styles/shop.css';
import { Picture } from 'astro:assets';
import { PRODUCTS, money } from '../../lib/shop';
import { SITE_URL } from '../../lib/site';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Shop · Holland Tunnel Gallery',
      url: `${SITE_URL}/shop`,
      isPartOf: { '@id': `${SITE_URL}/#gallery` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: PRODUCTS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE_URL}/shop/${p.slug}`, name: p.title })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Shop', item: `${SITE_URL}/shop` },
      ],
    },
  ],
};
---
<Base
  title="Shop: Books, Shirts & Bags | Holland Tunnel Gallery"
  description="The Holland Tunnel Gallery book, the Good Heavens! artist cookbook, and Jacques Roch T-shirts and tote bags. Order online and ship within the USA, or pick up at the gallery in Newburgh, NY."
  path="/shop"
  active="shop"
  jsonld={jsonld}
>
  <section class="s-section">
    <div class="s-wrap">
      <p class="s-kicker">Holland Tunnel Gallery</p>
      <h1 class="s-h1">Shop</h1>
      <p class="s-lede">Books, shirts and bags from Holland Tunnel. Send an order request and the gallery will email you to arrange payment and shipping, or pick it up at the gallery.</p>

      <ul class="s-grid">
        {PRODUCTS.map((p) => (
          <li class="s-card">
            <a href={`/shop/${p.slug}`}>
              <Picture src={p.images[0].src} alt={p.images[0].alt} formats={['avif', 'webp']} widths={[320, 640]} sizes="(max-width: 520px) 100vw, (max-width: 1100px) 45vw, 300px" loading="lazy" />
              <span class="s-kicker">{p.kind}</span>
              <span class="s-card-t">{p.title}</span>
              <span class="s-card-p">{money(p.price)}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="s-how">
        <div><b>1. Send a request</b><p>Choose the item, how many, and shipping or pickup. No payment is taken online.</p></div>
        <div><b>2. Hear from us</b><p>The gallery emails you to confirm the total and arrange payment.</p></div>
        <div><b>3. Ship or pick up</b><p>We ship within the USA, or you can collect it at 46 Chambers Street, Newburgh.</p></div>
      </div>
    </div>
  </section>
</Base>
