---
// Ported from the static demo (index.html) by scripts/port-demo-pages.py
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import { Picture, getImage } from 'astro:assets';
// Home images go through Astro's image pipeline: resized to their display size, AVIF/WebP, real dimensions.
import imgMusic from '../assets/home/soul-shades-julie-schatz-violin.jpg';
import imgPostcard from '../assets/home/holland-tunnel-postcard.webp';
import imgGibian from '../assets/home/reclamation-2025-gibian-gallery-view.webp';
import imgStudio1 from '../assets/rent/room-beams.jpg';
import imgStudio2 from '../assets/rent/room-wide.jpg';
import imgPaulien from '../assets/home/paulien-lethen-portrait.webp';
import imgFront from '../assets/home/46-chambers-street-front.jpg';
import imgDoors from '../assets/home/46-chambers-street-doors.jpg';
import imgHall from '../assets/home/46-chambers-street-hallway.jpg';
import imgRoom from '../assets/home/46-chambers-street-main-room.jpg';
import { onView, shortDate, longDate } from '../lib/onview';
import { eventNode } from '../lib/jsonld';
import { EMAIL } from '../lib/site';
import { loadArchive } from '../lib/people';
import PaintedMap from '../components/PaintedMap.astro';
const ov = await onView();
const show = ov?.show;
const badge = !ov ? '' :
  ov.status === 'current' ? (ov.lastWeekend ? `Last weekend · closes ${longDate(ov.end)}` : (ov.closes ? `Now on view · closes ${shortDate(ov.closes)}` : 'Now on view')) :
  ov.status === 'upcoming' ? `Opens ${longDate(show!.startDate)}` : 'Recently on view';
const metaDescription = ov?.status === 'current'
  ? `Holland Tunnel Gallery is open: now showing ${show!.title}${ov.closes ? ` through ${longDate(ov.closes)}` : ''}. Contemporary art, music, film and events at 46 Chambers Street, Newburgh, NY. Open Sat & Sun 1–5 pm. Since 1997.`
  : ov?.status === 'upcoming'
  ? `Holland Tunnel Gallery: ${show!.title} opens ${longDate(show!.startDate)}. Contemporary art, music, film and events at 46 Chambers Street, Newburgh, NY. Since 1997.`
  : 'Holland Tunnel Gallery: contemporary art, music, film and events at 46 Chambers Street, Newburgh, NY. Open Sat & Sun 1–5 pm and by appointment. Since 1997.';
const maps = 'https://www.google.com/maps/dir/?api=1&destination=46+Chambers+Street+Newburgh+NY+12550';
const appleMaps = 'https://maps.apple.com/?daddr=46+Chambers+Street,+Newburgh,+NY+12550';
// The address itself opens the exact spot (not directions): Apple Maps on Apple devices, Google Maps elsewhere.
const placeGoogle = 'https://www.google.com/maps/search/?api=1&query=46+Chambers+Street%2C+Newburgh%2C+NY+12550';
const placeApple = 'https://maps.apple.com/?address=46+Chambers+Street,+Newburgh,+NY+12550&ll=41.50177,-74.01141&q=Holland+Tunnel+Gallery';
// Storefront photos as plain JPEGs at stable URLs, so Google can use them as images of the place.
const SITE = 'https://www.hollandtunnelgallery.com';
const [frontJpg, doorsJpg] = await Promise.all([
  getImage({ src: imgFront, format: 'jpeg', width: 1200 }),
  getImage({ src: imgDoors, format: 'jpeg', width: 1200 }),
]);
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ArtGallery",
      "@id": "https://www.hollandtunnelgallery.com/#gallery",
      "name": "Holland Tunnel Gallery",
      "alternateName": [
        "Holland Tunnel Revisited",
        "Holland Tunnel Newburgh"
      ],
      "description": "Contemporary art gallery, music and event space in Newburgh's Historic District. Founded in 1997 in Williamsburg, Brooklyn by Paulien Lethen.",
      "foundingDate": "1997",
      "logo": "https://www.hollandtunnelgallery.com/brand/favicon-512.png",
      "url": "https://www.hollandtunnelgallery.com/",
      "email": EMAIL,
      // what the place looks like (storefront first), where it is exactly, and its map
      "image": [
        { "@type": "ImageObject", "url": SITE + frontJpg.src, "caption": "Holland Tunnel Gallery, 46 Chambers Street, Newburgh NY: the red-brick building with the black door marked 46" },
        { "@type": "ImageObject", "url": SITE + doorsJpg.src, "caption": "The doors of Holland Tunnel Gallery at street level on Chambers Street, Newburgh NY" },
        "https://www.hollandtunnelgallery.com/img/og-unframed.jpg",
      ],
      "geo": { "@type": "GeoCoordinates", "latitude": 41.50177, "longitude": -74.01141 },
      "hasMap": placeGoogle,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "46 Chambers Street",
        "addressLocality": "Newburgh",
        "addressRegion": "NY",
        "postalCode": "12550",
        "addressCountry": "US"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Saturday",
            "Sunday"
          ],
          "opens": "13:00",
          "closes": "17:00"
        }
      ],
      "founder": {
        "@type": "Person",
        "name": "Paulien Lethen",
        "url": "https://paulienlethen.com"
      },
      "sameAs": [
        "https://en.wikipedia.org/wiki/Holland_Tunnel_Gallery",
        "https://www.instagram.com/hollandtunnelnewburgh/"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.hollandtunnelgallery.com/#website",
      "url": "https://www.hollandtunnelgallery.com/",
      "name": "Holland Tunnel Gallery",
      "publisher": { "@id": "https://www.hollandtunnelgallery.com/#gallery" },
      "creator": {
        "@type": "Person",
        "@id": "https://www.robertvanliew.com/#person",
        "name": "Robert Van Liew",
        "url": "https://www.robertvanliew.com/"
      }
    }
  ]
};
if (show) (jsonld["@graph"] as object[]).push(eventNode(show, { performers: ov!.people }));

// Recent shows: the newest exhibitions with a photo, after the one in the hero.
const archive = await loadArchive();
const recent = [...archive.shows.values()]
  .filter((s) => !s.isMusic && s.image && s.id !== show?.id)
  .sort((a, b) => b.startDate.localeCompare(a.startDate))
  .slice(0, 4);
// Artists block: everyone with a profile page, the most-shown first, as a sample of the archive.
const profiled = archive.people.filter((p) => p.published);
const chips = [...profiled].sort((a, b) => b.showIds.length - a.showIds.length || a.name.localeCompare(b.name)).slice(0, 16)
  .sort((a, b) => a.name.localeCompare(b.name));
const moreCount = archive.people.length - chips.length;
// Program list: concerts coming up, else ones played in the last 30 days (newest first), from the show data.
const todayIso = ov?.today ?? new Date().toISOString().slice(0, 10);
const daysAgo = (iso: string) => (Date.parse(todayIso) - Date.parse(iso)) / 86_400_000;
const allMusic = [...archive.shows.values()].filter((s) => s.isMusic && s.startDate.length === 10);
const soon = allMusic.filter((s) => s.startDate >= todayIso).sort((a, b) => a.startDate.localeCompare(b.startDate));
const lately = allMusic.filter((s) => s.startDate < todayIso && daysAgo(s.startDate) <= 30).sort((a, b) => b.startDate.localeCompare(a.startDate));
const concerts = (soon.length ? soon : lately).slice(0, 2).map((s) => ({
  show: s,
  upcoming: s.startDate >= todayIso,
  when: new Date(`${s.startDate}T12:00:00`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }),
  people: (archive.showPeople.get(s.id) ?? []).map((slug) => archive.bySlug.get(slug)!.name),
}));
---
<Base title={"Holland Tunnel Gallery · Art, Music & Events in Newburgh, NY"} description={metaDescription} path="/" jsonld={jsonld}>

  <!-- Hero: the featured exhibition (on now, coming up, or most recent), from the show data -->
  {ov && show && (
  <section class="h-hero">
    <div class="h-wrap h-hero-in">
      <div class="h-hero-text">
        <div>
          <h1 class="h-intro"><b>Holland Tunnel Gallery</b> · Contemporary art, music &amp; film in Newburgh, NY</h1>
          <p class="h-badge" data-until={ov.status === 'current' ? ov.closes ?? undefined : undefined}>
            {ov.status === 'current' && <span class="dot" aria-hidden="true"></span>}{badge}{ov.status === 'between' && <> · {show.dates}</>}
          </p>
          <h2 class="h-title" style={`--tw:${Math.max(6, ...show.title.split(/\s+/).map((w) => w.length))}`}>{show.title}</h2>
          {show.description
            ? <p class="h-lede">{show.description.split(/(?<=\.)\s/)[0]}</p>
            : <p class="h-lede">{show.dates}</p>}
          {ov.status === 'between' && <p class="h-note">The next exhibition will be announced soon. Visit by appointment, or join the list to hear about the opening first.</p>}
          {ov.status !== 'between' && <p class="h-note">{show.dates} · Open Saturday &amp; Sunday, 1–5 pm · Free</p>}
        </div>
        <div>
          {ov.people.length > 0 && (
            <>
              <p class="h-label">The artists</p>
              <p class="h-names">{ov.people.map((p, i) => <>{i > 0 && ', '}{p.url ? <a href={p.url}>{p.name}</a> : p.name}</>)}</p>
            </>
          )}
          <div class="h-btns">
            <a class="h-btn" href={ov.status === 'between' ? show.url : '/exhibitions'}>See the show</a>
            {ov.status === 'between'
              ? <a class="h-btn h-btn--line" href="#newsletter">Hear about the next opening</a>
              : <a class="h-btn h-btn--line" href={maps}>Get directions</a>}
          </div>
        </div>
      </div>
      <figure class="h-hero-fig">
        {show.image ? (
          <Picture src={show.image} alt={show.imageAlt!} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 900px) calc(100vw - 32px), 760px" loading="eager" fetchpriority="high" />
        ) : (
          <img src="/img/og-unframed.jpg" alt="" width="1200" height="630" />
        )}
        {show.imageAlt && <figcaption>{show.imageAlt}</figcaption>}
      </figure>
    </div>
  </section>
  )}

  <!-- Program: music, film, schools -->
  <section class="h-dark" id="next-up">
    <div class="h-wrap">
      <div class="h-head">
        <div>
          <p class="h-kicker">On Chambers Street</p>
          <h2 class="h-h2">Art, music &amp; film</h2>
        </div>
        <a class="h-more" href="#newsletter">Get the monthly email →</a>
      </div>
      <ul class="h-program">
        {concerts.map((c) => (
          <li>
            <p class="h-when">{c.when}</p>
            <div class="h-what">
              <p class="h-tag">{c.upcoming ? 'Concert · Coming up' : 'Concert · Just played'}{c.show.reception && ` · ${c.show.reception.replace(/^[A-Za-z]+, [A-Za-z]+ \d+, /, '')}`}</p>
              <h3><a href={c.show.url}>{c.show.title}<span class="h-go" aria-hidden="true">→</span></a></h3>
              <p>{c.people.length ? `${c.people.join(' & ')}. ` : ''}{c.upcoming ? 'Suggested donation $10.' : 'Join the list to hear about the next one.'}</p>
            </div>
            {c.show.image && <Picture src={c.show.image} alt="" formats={['avif', 'webp']} widths={[240, 480, 720]} sizes="(max-width: 700px) calc(100vw - 32px), 240px" loading="lazy" decoding="async" />}
          </li>
        ))}
        <li>
          <p class="h-when">This fall</p>
          <div class="h-what">
            <p class="h-tag">Music night · New</p>
            <h3><a href="/artists/julie-schatz">Soul Shades: Turntablism on the Decks<span class="h-go" aria-hidden="true">→</span></a></h3>
            <p>Soul Shades, the duo of Julie Schatz on violin and piano and DJ DX on the decks, blend live strings with turntablism: soul, jazz and Latin, mixed and cut live, with the baby grand as a backdrop. A new monthly night, built around the show on view.</p>
          </div>
          <Picture src={imgMusic} alt="Julie Schatz of Soul Shades playing violin in the gallery" formats={['avif', 'webp']} widths={[240, 480, 720]} sizes="(max-width: 700px) calc(100vw - 32px), 240px" loading="lazy" decoding="async" />
        </li>
        <li id="cinema-club">
          <p class="h-when">Monthly</p>
          <div class="h-what">
            <p class="h-tag">Cinema Club · Doors 6 pm, film 7 pm</p>
            <h3><a href="#newsletter">Cinema Club<span class="h-go" aria-hidden="true">→</span></a></h3>
            <p>Classic films picked by programmer Kent Peterson, hosted by Paulien Lethen. Free popcorn, drinks available. Membership $10 a year, then $5 a film.</p>
          </div>
          <Picture src={imgPostcard} alt="" quality={55} formats={['avif', 'webp']} widths={[240, 480, 720]} sizes="(max-width: 700px) calc(100vw - 32px), 240px" loading="lazy" decoding="async" />
        </li>
        <li>
          <p class="h-when">By booking</p>
          <div class="h-what">
            <p class="h-tag">Schools · Grades 6–12</p>
            <h3><a href="/schools">School visits<span class="h-go" aria-hidden="true">→</span></a></h3>
            <p>An artist film in the screening room, a guided look at the show, a hands-on workshop and a wrap-up.</p>
          </div>
          <Picture src={imgGibian} alt="" formats={['avif', 'webp']} widths={[240, 480, 720]} sizes="(max-width: 700px) calc(100vw - 32px), 240px" loading="lazy" decoding="async" />
        </li>
      </ul>
    </div>
  </section>

  <!-- Recent shows -->
  {recent.length > 0 && (
  <section class="h-section">
    <div class="h-wrap">
      <div class="h-head">
        <h2 class="h-h2">Recent shows</h2>
        <a class="h-more" href="/exhibitions">All exhibitions since 1997 →</a>
      </div>
      <ul class="h-shows">
        {recent.map((s) => (
          <li>
            <a href={s.url}>
              <Picture src={s.image!} alt={s.imageAlt!} formats={['avif', 'webp']} widths={[320, 640]} sizes="(max-width: 600px) 70vw, 300px" loading="lazy" />
              <span class="h-label">{s.dates}</span>
              <span class="h-show-t">{s.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}

  <!-- Artists -->
  <section class="h-section h-ruled">
    <div class="h-wrap h-artists">
      <div>
        <p class="h-big" aria-hidden="true" data-count>{archive.people.length}</p>
        <h2 class="h-h2 h-h2--sm"><span class="vh">{archive.people.length} </span>Artists &amp; musicians, one network</h2>
        <p>Every artist who has shown or played here, and who they've shown with. Follow the connections from one show to the next.</p>
        <a class="h-btn h-btn--ink" href="/artists">Explore the artists</a>
      </div>
      <div>
        <ul class="h-chips">
          {chips.map((p) => <li><a class={p.group === 'music' ? 'is-music' : undefined} href={p.url!}>{p.name}{p.group === 'music' && <span class="vh">, musician</span>}</a></li>)}
          <li><a class="h-chips-more" href="/artists">+ {moreCount} more →</a></li>
        </ul>
        <p class="h-key"><span><i aria-hidden="true"></i>Visual artists</span><span><i class="is-music" aria-hidden="true"></i>Musicians &amp; performers</span></p>
      </div>
    </div>
  </section>

  <!-- Story + press -->
  <section class="h-section" id="story">
    <div class="h-wrap h-story">
      <div>
        <p class="h-label">Since 1997</p>
        <h2 class="h-h2">From a garden shed in Williamsburg to Newburgh</h2>
        <p>Paulien Lethen opened Holland Tunnel in 1997 in a Home Depot garden shed in her Williamsburg backyard. It grew into a Brooklyn institution, a summer gallery on the Greek island of Paros, and since 2018, a home in an 1860 warehouse in Newburgh's Historic District.</p>
        <p>Today, as Holland Tunnel Revisited, it runs a full program of shows, concerts and films, open every weekend.</p>
        <div class="h-founder">
          <Picture src={imgPaulien} alt="Paulien Lethen standing in a gallery doorway" formats={['avif', 'webp']} widths={[84, 168]} sizes="84px" loading="lazy" decoding="async" />
          <p>Paulien Lethen, artist and founder-director. Featured in Yara Hannema's documentary <em>Requiem for Williamsburg</em>.</p>
        </div>
      </div>
      <div class="h-story-side">
        <blockquote class="h-quote">
          <p>“One of the quirkiest spaces in Williamsburg … a front-runner for first place as the tiniest gallery in the metropolitan area.”</p>
          <cite>Roberta Smith, The New York Times</cite>
        </blockquote>
        <ol class="h-timeline">
          <li><b>1997</b>Garden shed, Williamsburg</li>
          <li><b>2000</b>Summer gallery, Paros</li>
          <li><b>2018</b>Opens in Newburgh</li>
          <li><b>2025</b>Holland Tunnel Revisited</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Rent -->
  <section class="h-rent">
    <div class="h-wrap h-rent-in">
      <div class="h-rent-text">
        <p class="h-kicker">Rent the studio</p>
        <h2 class="h-h2">A studio upstairs, by the hour or month</h2>
        <p>900 square feet on the second floor, with wood floors, tall ceilings and big windows. Rent it by the hour for workshops, rehearsals, shoots and meetings, or by the month as your own studio.</p>
        <div class="h-btns">
          <a class="h-btn h-btn--ink" href="/rent#inquire">Check availability</a>
          <a class="h-btn h-btn--line" href="/rent">See the studio</a>
        </div>
      </div>
      <div class="h-rent-pics">
        <Picture src={imgStudio1} alt="The upstairs studio: wide wooden floorboards, a timber post and beam, and tall windows" formats={['avif', 'webp']} widths={[320, 480, 640, 960]} sizes="(max-width: 600px) 45vw, 330px" loading="lazy" decoding="async" />
        <Picture src={imgStudio2} alt="The studio in daylight, with windows on two sides" formats={['avif', 'webp']} widths={[320, 480, 640, 960]} sizes="(max-width: 600px) 45vw, 330px" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- Visit -->
  <section class="h-section" id="visit">
    <div class="h-wrap h-visit">
      <div>
        <h2 class="h-h2">Plan your visit</h2>
        <dl class="h-facts">
          <dt>Address</dt><dd><a href={placeGoogle} data-addr-link data-apple={placeApple}>46 Chambers Street, Newburgh, NY 12550</a><br /><span>Historic District, between Broadway and First Street</span></dd>
          <dt>Hours</dt><dd>Saturday &amp; Sunday, 1–5 pm, and by appointment</dd>
          <dt>Admission</dt><dd>Free</dd>
          <dt hidden>This weekend</dt>
          <dd data-wx hidden aria-live="polite">
            <ul class="h-wx-list"></ul>
            <a class="h-wx-more" href="https://forecast.weather.gov/MapClick.php?lat=41.5018&lon=-74.0114">Full forecast from the National Weather Service →</a>
          </dd>
          <dt>Contact</dt><dd><a href={`mailto:${EMAIL}`} data-contact="visit">{EMAIL}</a><br /><a href="https://www.instagram.com/hollandtunnelnewburgh/">@hollandtunnelnewburgh</a></dd>
        </dl>
        <p class="h-aside">Bringing a class? <a href="/schools">School visits for grades 6–12 →</a></p>
      </div>
      <figure class="h-map">
        <PaintedMap label="Holland Tunnel" mapsUrl={placeGoogle} appleUrl={placeApple} directionsGoogle={maps} directionsApple={appleMaps}
          photos={[
            { src: imgFront, tab: 'The building', focus: '50% 86%',
              caption: 'The red-brick building with the black door marked 46',
              alt: 'Holland Tunnel Gallery at 46 Chambers Street, Newburgh NY: a three-story red-brick building with arched windows and a black roll-up door marked 46, between two black doors' },
            { src: imgDoors, tab: 'At the door',
              caption: 'At street level on Chambers Street',
              alt: 'The doors of Holland Tunnel Gallery seen from the sidewalk on Chambers Street, Newburgh NY: a black roll-up door marked 46 and a black gated door in red brick' },
            { src: imgHall, tab: 'Inside',
              caption: 'Inside: the gallery hallway',
              alt: 'Inside Holland Tunnel Gallery: a long white hallway with framed works on the walls, black pendant lamps and wide-plank wood floors' },
            { src: imgRoom, tab: 'Main room',
              caption: 'The main room, with the baby grand',
              alt: 'The main room at Holland Tunnel Gallery: a black baby grand piano under a chandelier, framed black-and-white works on the walls, and musicians setting up' },
          ]} />
        <figcaption class="h-map-card">
          <div>
            <p class="h-kicker">Holland Tunnel Gallery</p>
            <p class="h-map-addr"><a href={placeGoogle} data-addr-link data-apple={placeApple}>46 Chambers Street</a><span>Newburgh, NY 12550 · Historic District</span></p>
            <p class="h-map-open"><span class="dot" aria-hidden="true"></span>Open Saturday &amp; Sunday, 1–5 pm</p>
          </div>
          <div class="h-map-links">
            <a class="h-btn h-btn--ink" href={maps}>Google Maps</a>
            <a class="h-btn h-btn--line" href={appleMaps}>Apple Maps</a>
          </div>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- FAQ: short, factual answers that search engines and AI assistants can quote -->
  <section class="h-section h-ruled">
    <div class="h-wrap h-faq-wrap">
      <h2 class="h-h2">Good to know</h2>
      <div class="h-faq">
        <details>
          <summary>Is Holland Tunnel Gallery open?</summary>
          <p>Yes. The gallery is open Saturday and Sunday from 1 to 5 pm, and by appointment, at 46 Chambers Street in Newburgh, NY.{ov?.status === 'current' && ` ${show!.title} is on view now${ov.closes ? ` through ${longDate(ov.closes)}` : ''}.`}{ov?.status === 'upcoming' && ` ${show!.title} opens ${longDate(show!.startDate)}.`}{ov?.status === 'between' && ' The next exhibition will be announced soon; join the mailing list to hear first.'}</p>
        </details>
        <details>
          <summary>Can I rent a space at Holland Tunnel?</summary>
          <p>Yes. The 900 sq ft studio on the second floor of 46 Chambers Street is for rent by the hour, for workshops, rehearsals, shoots, meetings and small gatherings, or by the month as a private studio with heat and electricity included. <a href="/rent">See the studio</a>.</p>
        </details>
        <details>
          <summary>Is it the same Holland Tunnel Gallery from Williamsburg?</summary>
          <p>Yes. Paulien Lethen founded Holland Tunnel in Williamsburg, Brooklyn in 1997, ran a summer gallery on Paros, Greece from 2000, and moved the gallery to Newburgh in 2018.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="h-join" id="newsletter">
    <div class="h-wrap h-join-in">
      <div>
        <h2 class="h-h2">Don't miss an opening</h2>
        <p>One email a month: the show on view, films, music nights and openings. No spam.</p>
      </div>
      <form class="h-join-form" name="newsletter" method="POST" action="/api/forms">
        <input type="hidden" name="form-name" value="newsletter" />
        <p class="vh"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
        <label for="nl-email">Email address</label>
        <div>
          <input id="nl-email" type="email" name="email" placeholder="you@email.com" required autocomplete="email" />
          <button type="submit">Sign up</button>
        </div>
      </form>
    </div>
  </section>

<script is:inline>
  // Motion failsafe: if the home motion script hasn't started within 3 s, show everything as is.
  setTimeout(function () { var d = document.documentElement; if (!d.classList.contains('hm-ok')) d.classList.add('hm-timeout'); }, 3000);
</script>
<script>
  import '../scripts/home-motion.ts';
  import '../scripts/weekend-weather.ts';
</script>
<script is:inline>
  // Address links open Apple Maps on iPhone, iPad and Mac (the app those visitors use); Google Maps elsewhere.
  if (/iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent))
    document.querySelectorAll('[data-addr-link]').forEach(function (a) { a.href = a.getAttribute('data-apple'); });
</script>
<script src="/js/site.js" is:inline defer></script>
</Base>
