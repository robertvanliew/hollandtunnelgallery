---
// One page per show (/exhibitions/<id>) or concert/performance (/events/<id>).
// Lists and links everyone in it, so profiles and shows link both ways.
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumb from './artists/Breadcrumb.astro';
import ArtistCard from './artists/ArtistCard.astro';
import { loadArchive, truncate, type Show } from '../lib/people';
import { breadcrumbs, eventNode } from '../lib/jsonld';
import '../styles/artists.css';

interface Props { show: Show }
const { show: s } = Astro.props;
const a = await loadArchive();
const people = (a.showPeople.get(s.id) ?? []).map((slug) => a.bySlug.get(slug)!);
const published = people.filter((p) => p.published);
const pending = people.filter((p) => !p.published);
const section = s.isMusic ? { name: 'Events', href: '/events' } : { name: 'Exhibitions', href: '/exhibitions' };
const share = s.image ? await getImage({ src: s.image, width: 1200, format: 'jpg' }) : null;
const today = new Date().toISOString().slice(0, 10);
const onNow = (s.endDate ?? s.startDate) >= today;
// Named in the show but without a profile (yet): listed by name, never guessed into a link.
const others = (s.artists ?? []).filter((n) => !people.some((p) => p.name === n || a.findByName(n)?.slug === p.slug));
const names = [...people.map((p) => p.name), ...others];
const posterSrc = s.video ? (await getImage({ src: s.video.poster, width: 720, format: 'jpeg' })).src : undefined;
const desc = truncate(
  s.description ? `${s.title}, ${s.dates}, at Holland Tunnel Gallery, Newburgh NY. ${s.description}` : `${s.title} (${s.dates}), ${s.type.toLowerCase()} at Holland Tunnel Gallery, Newburgh NY.${names.length ? ' With ' + names.join(', ') + '.' : ''}`,
);
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    eventNode(s, { image: share?.src, performers: people }),
    breadcrumbs([['Home', '/'], [section.name, section.href], [s.title, s.url]]),
  ],
};
---
<Base title={`${s.title} · ${s.year} | Holland Tunnel Gallery`} description={desc} path={s.url}
  active={s.isMusic ? 'events' : 'exhibitions'} ogImage={share?.src} jsonld={jsonld}>
  <Breadcrumb items={[section, { name: s.title }]} />
  <section class="show-hero">
    <div>
      <p class="kicker">{s.type}</p>
      <h1>{s.title}</h1>
      <p class="show-meta">{s.reception ?? s.dates}</p>
      <p class="rec-meta">{s.venue}</p>
      {s.description && <p class="show-desc">{s.description}</p>}
      {onNow && <p style="margin-top:18px"><a class="btn" href="/#visit">Plan your visit</a></p>}
    </div>
    {s.image && (
      <figure class="hero-fig">
        <Picture src={s.image} alt={s.imageAlt!} formats={['avif', 'webp']} widths={[480, 800, 1200]}
          sizes="(max-width: 960px) calc(100vw - 32px), 560px" loading="eager" fetchpriority="high" />
        <figcaption>{s.imageAlt}</figcaption>
      </figure>
    )}
  </section>
  {(s.about?.length || s.program?.length || s.statements?.length || s.press?.length) && (
    <section class="show-text" aria-labelledby="st-h">
      <div class="st-main">
        {s.about?.length && (
          <>
            <h2 id="st-h" class="block-h">{s.aboutTitle ?? 'About the show'}</h2>
            {s.about.map((t, i) => <p class={i === 0 ? 'lede' : undefined}>{t}</p>)}
          </>
        )}
        {s.statements?.map((st) => (
          <article class="st-statement">
            <h3>{st.by}{st.title && <span>{st.title}</span>}</h3>
            {st.paragraphs.map((t) => <p>{t}</p>)}
          </article>
        ))}
      </div>
      {(s.program?.length || s.press?.length) && (
        <aside class="st-side">
          {s.program?.length && (
            <>
              <h2 class="block-h" id={s.about?.length ? undefined : 'st-h'}>Program</h2>
              <ul class="st-program">{s.program.map((p) => <li><b>{p.date}</b><span>{p.text}</span></li>)}</ul>
            </>
          )}
          {s.press?.length && (
            <>
              <h2 class="block-h">Press</h2>
              <ul class="st-press">{s.press.map((p) => <li><a href={p.url} rel="noopener">{p.title}</a><span>{p.outlet}</span></li>)}</ul>
            </>
          )}
        </aside>
      )}
    </section>
  )}
  {(s.video || s.gallery?.length) && (
    <section class="show-media" aria-labelledby="sm-h">
      <h2 id="sm-h" class="block-h" style="font:400 30px/1 var(--display);letter-spacing:.05em;margin:0 0 18px">Photos &amp; video</h2>
      {s.video && (
        <figure class="sm-video">
          <video controls playsinline preload="none" poster={posterSrc} width="406" height="720">
            <source src={s.video.src} type="video/mp4" />
          </video>
          <figcaption>{s.video.caption}</figcaption>
        </figure>
      )}
      {s.gallery && (
        <ul class="sm-grid">
          {s.gallery.map((g) => (
            <li>
              <figure>
                <Picture src={g.image} alt={g.alt} formats={['avif', 'webp']} widths={[400, 700, 1000]}
                  sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1100px) 45vw, 360px" loading="lazy" decoding="async" />
                <figcaption>{g.alt}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}
  {names.length > 0 && (
    <section class="show-people" aria-labelledby="sp-h">
      <h2 id="sp-h" class="block-h" style="font:400 30px/1 var(--display);letter-spacing:.05em;margin:0 0 18px">
        {s.isMusic ? 'Musicians & performers' : 'Artists in this show'}
      </h2>
      {published.length > 0 && <ul class="cards">{published.map((p) => <ArtistCard p={p} a={a} />)}</ul>}
      {(pending.length > 0 || others.length > 0) && (
        <p class="sub" style={published.length ? 'margin-top:22px' : undefined}>
          {published.length ? 'Also in this show: ' : ''}{[...pending.map((p) => p.name), ...others].join(', ')}.
        </p>
      )}
    </section>
  )}
</Base>
